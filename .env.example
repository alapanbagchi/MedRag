# ─────────────────────────────────────────────────────────────────────
# MedRAG local application — copy to .env and fill in your values.
# Everything here is LOCAL configuration; the Kaggle notebook sees none
# of it (Kaggle only receives system+user prompts).
# ─────────────────────────────────────────────────────────────────────

# ── Inference provider (what PydanticAI agents call) ─────────────────
# EITHER Kaggle as an OpenAI-compatible endpoint (kaggle/medrag_inference.ipynb)…
LLM_PROVIDER=gemini            # kaggle | openai | ollama | vllm | gemini | mistral
# KAGGLE_BASE_URL=https://<your-tunnel>.trycloudflare.com/v1
# KAGGLE_API_KEY=dummy
# KAGGLE_MODEL=medgemma

# …OR Gemini with an API key from Google AI Studio:
#   get a key at https://aistudio.google.com/apikey (free tier included)
# Uses Google's OpenAI-compatible layer, so the whole local stack
# (PydanticAI agents, chat client) works unchanged.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-2.5-flash      # gemini-2.0-flash no longer exists on this endpoint

# …OR Mistral (OpenAI-compatible API). Get a key at https://console.mistral.ai
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# MISTRAL_API_KEY=your-mistral-api-key
# MISTRAL_MODEL=mistral-large-latest   # also: mistral-small-latest, open-mistral-nemo

# Alternate providers (switch by changing LLM_PROVIDER only):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=medgemma
# VLLM_BASE_URL=http://127.0.0.1:8000/v1
# VLLM_MODEL=medgemma
# AGENT_MAX_TOKENS=2048    # Gemini default; 512 for the 512-capped Kaggle endpoint

# ── Per-agent LLM routing (optional) ─────────────────────────────────
# Everything uses LLM_PROVIDER by default. Set a role override to pin a
# DIFFERENT provider/model for one agent only. Roles (env prefix, each accepts
# _PROVIDER / _BASE_URL / _API_KEY / _MODEL):
#   ORCHESTRATOR_  master planner          VERIFIER_  critic / verification
#   SYNTHESIZER_   final answer            PLANNER_   search-term + replan
#   CONTRADICTION_ / RESOLUTION_ / DEEP_INSPECTOR_
# An unset role _API_KEY falls back to that provider's global key.
#
# Example: Gemma everywhere, Mistral ONLY for verification:
#   LLM_PROVIDER=gemini
#   GENERAL_LLM_MODEL=gemma-2-27b-it
#   MISTRAL_API_KEY=your-mistral-key            # fallback key for the role
#   VERIFIER_PROVIDER=mistral
#   VERIFIER_MODEL=mistral-medium-latest

# ── Mistral Batch API for verification (critic) ──────────────────────
# When the verifier runs on Mistral, all critic calls of one worker round
# go into a SINGLE batch job (/v1/batch/jobs) instead of one call per
# passage. Requires a Mistral plan with BILLING ENABLED (otherwise the
# worker logs a warning and falls back to sequential calls automatically).
# Critic verifications run as PARALLEL single requests, started at most
# one per second (1 req/s) so free-tier rate limits are respected - the
# free Mistral tier cannot submit Batch API jobs, so batching is unused.

# ── Local UMLS / MeSH terminology service ────────────────────────────
# Get a free UTS account + API key at https://uts.nlm.nih.gov/uts/
UMLS_API_KEY=
UMLS_SABS=MSH
UMLS_BASE_URL=https://uts-ws.nlm.nih.gov/rest
UMLS_MAX_SYNONYMS=5

# ── Local retrieval / vector store ───────────────────────────────────
INDEX_DIR=index
CHUNKS_DIR=chunks
EMBEDDINGS_DIR=embeddings
# Leave empty to use the FAISS dense index; set to a pgvector DSN to use
# PostgreSQL pgvector instead (see scripts/init_pgvector.py):
VECTOR_DB_URL=
EMBEDDING_MODEL=ncbi/MedCPT-Query-Encoder
RERANKER_MODEL=                 # optional cross-encoder id
ENABLE_DENSE=false              # dense retrieval needs encoders + index
BM25_DEPTH=100
DENSE_DEPTH=100
RRF_K=60

# ── Budget / orchestration ───────────────────────────────────────────
MAX_DOCUMENTS=8                 # max evidence documents per subquery
MAX_WORKERS=8                   # concurrent evidence-extraction workers
MAX_RETRIES=3                   # per-LLM-call retries
REQUEST_TIMEOUT=180             # per-LLM-call timeout (seconds)
TEMPERATURE=0.0

# ── Logfire observability (Pydantic AI → Logfire) ────────────────────
# Every PydanticAI agent call (prompt, response, tokens, cost, latency) plus
# the application trace events (stages, retrievals, verdicts, deep
# inspections) stream to Logfire. Configure once with `logfire auth` (or run
# `logfire project create`), which writes .logfire/logfire_credentials.json.
#
# LOGFIRE_ENABLED=auto          # auto | 1/on | 0/off
#                               # auto = enabled iff credentials/token exist
# LOGFIRE_SERVICE_NAME=medrag
# LOGFIRE_ENVIRONMENT=development
# LOGFIRE_CONSOLE=false         # true to print spans to the terminal too
#
# Alternative to the credentials file: paste a project write token here.
# LOGFIRE_TOKEN=pylf_v1_...