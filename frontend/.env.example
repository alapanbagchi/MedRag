# MedPat frontend — RAG connection
# Point at your MedPat backend when it is ready.
NEXT_PUBLIC_RAG_API_URL=http://localhost:8000

# Stream events (status | sources | token | done) arrive as newline-delimited
# JSON from POST  {NEXT_PUBLIC_RAG_API_URL}/v1/chat/stream
# Until the backend exists, keep mock mode ON:
NEXT_PUBLIC_USE_MOCK=true
