# ─────────────────────────────────────────────────────────────────────
# MedRAG local application — copy to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────

# ── Inference providers (everything the agents call is OpenAI-compatible)
# Think side (decompose / research workers / synthesis / conflict) routes:
#   XDEEP_THINK_PROVIDER force, else QWEN_* set, else GROQ_API_KEY set,
#   else GENERAL_LLM_BASE_URL on Alibaba MaaS, else LLM_PROVIDER=opencode,
#   else the shared GENERAL_LLM_* endpoint.
LLM_PROVIDER=alibaba            # alibaba | groq | google | opencode
GENERAL_LLM_BASE_URL=https://<your>.aliyuncs.com/compatible-mode/v1
GENERAL_LLM_API_KEY=
GENERAL_LLM_MODEL=qwen3.8-flash
# XDEEP_THINK_PROVIDER=qwen     # force: qwen | alibaba | aliyun | groq | google | opencode
# QWEN_BASE_URL=                # overrides GENERAL_LLM_BASE_URL for think
# QWEN_API_KEY=                 # overrides GENERAL_LLM_API_KEY for think
# QWEN_MODEL=qwen3.8-flash
# GROQ_API_KEY=                 # fast alternative think side
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=gemma2-9b-it
# XDEEP_GROQ_TPM=8000           # Groq token-per-minute guard
# OPENCODE_BASE_URL=            # Muse Spark think side (Responses API)
# OPENCODE_API_KEY=
# OPENCODE_MODEL=muse-spark-1.3-contributor-free
# Mistral serves the short-decision side (verifier, contradiction,
# resolution, reliability critic) - paced 1 req / 1.5s:
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-medium-latest

# ── Mistral pacing ─────────────────────────────────────────────────
# The short-decision side (verifier, contradiction, resolution,
# reliability critic) is paced at 1 request / 1.5s process-wide, so the
# free Mistral tier is never hammered.

# ── Local UMLS / MeSH terminology service ────────────────────────────
# Get a free UTS account + API key at https://uts.nlm.nih.gov/uts/
UMLS_API_KEY=
UMLS_SABS=MSH
UMLS_BASE_URL=https://uts-ws.nlm.nih.gov/rest
UMLS_MAX_SYNONYMS=5

# ── SearXNG web search (agents flow) ─────────────────────────────────
# Self-hosted metasearch engine; xdeep uses it for WEB evidence only when
# the local corpus (retriever) does not cover what it needs. Social media /
# forums are never trusted; only medical journals + official medical sites
# pass the site-legitimacy gate.
# Start it:  make searxng-up   (docker, port 8888) - see backend/Makefile
SEARXNG_URL=http://127.0.0.1:8888      # or XDEEP_SEARXNG_URL
# SEARXNG_TIMEOUT=15.0                  # HTTP timeout (seconds)
# SEARXNG_TOP_K=8                       # default results per search

# ── Local retrieval / vector store ───────────────────────────────────
INDEX_DIR=index
CHUNKS_DIR=chunks
EMBEDDINGS_DIR=embeddings
# Leave empty to use the FAISS dense index; set to a pgvector DSN to use
# PostgreSQL pgvector instead (see scripts/init_pgvector.py):
VECTOR_DB_URL=
EMBEDDING_MODEL=ncbi/MedCPT-Query-Encoder
ENABLE_DENSE=false              # dense retrieval needs encoders + index
BM25_DEPTH=100
DENSE_DEPTH=100
RRF_K=60

# ── Research budgets ─────────────────────────────────────────────────
# Evidence targets per requirement + retrieval fan-out (read by the agents
# flow). Stage timeouts and worker fan-out are XDEEP_TIMEOUT_* /
# XDEEP_MAX_WORKERS (see src/agents/timeouts.py).
MAX_DOCUMENTS=8                 # max evidence documents per subquery
# AGENTIC_V3_EVIDENCE_TARGET=3  # verified papers required per requirement
# AGENTIC_V3_MAX_SEARCHES=5     # search budget per worker
# AGENTIC_V3_MAX_RETRIEVAL_ROUNDS=5
# AGENTIC_V3_PAPERS_PER_SEARCH=5
# XDEEP_MAX_WORKERS=4           # parallel research workers
# XDEEP_TIMEOUT_WORKER=360      # seconds per worker; also DECOMPOSE/CONFLICT/
                                # RESOLUTION/GAP/SYNTHESIS/LLM_CALL variants

# ── Logfire observability (Pydantic AI → Logfire) ────────────────────
# Every PydanticAI agent call (prompt, response, tokens, cost, latency) plus
# the application trace events (stages, retrievals, verdicts, deep
# inspections) stream to Logfire. Configure once with `logfire auth` (or run
# `logfire project create`), which writes .logfire/logfire_credentials.json.
#
# LOGFIRE_ENABLED=auto          # auto | 1/on | 0/off
#                               # auto = enabled iff credentials/token exist
# LOGFIRE_SERVICE_NAME=medrag
# LOGFIRE_ENVIRONMENT=development
# LOGFIRE_CONSOLE=false         # true to print spans to the terminal too
#
# Alternative to the credentials file: paste a project write token here.
# LOGFIRE_TOKEN=pylf_v1_...