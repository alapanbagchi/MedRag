# ─────────────────────────────────────────────────────────────────────
# MedRAG local application — copy to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────

# ── LLM lanes: the only model config the backend reads ──────────────
# One shared OpenAI-compatible endpoint plus one model id per lane.
# OpenCode Go users: LLM_BASE_URL=https://opencode.ai/zen/go/v1/ (Mimo-V2.5,
# Kimi K3, GLM-5.3, Grok 4.6, ... all work through it).
LLM_BASE_URL=https://<your>.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
# AGENT_MODEL: the big thinking agentic LLM (deep agent, planner, synthesis).
AGENT_MODEL=qwen3.7-plus
# SMALL_MODEL: small tasks (evidence planner, trust checker).
SMALL_MODEL=qwen3.8-27b
#
# ── LLM session / prompt cache ──────────────────────────────────────
# The backend sends ONE x-opencode-session id on every LLM call — master,
# sub-agents, verifier, every judge — so the shared system prompts are cached
# once and reused across the whole process. Set LLM_SESSION_ID to any stable
# string to pin it; unset falls back to a stable per-process id (the gateway
# rejects a request with no session at all: HTTP 400 MissingSessionID). The
# legacy name OPENCODE_SESSION is still honored.
# LLM_SESSION_ID=
#
# ── API style ────────────────────────────────────────────────────────
# auto = muse-spark models (OpenCode Go serves them only through the OpenAI
# Responses API /responses) use OpenAIResponsesModel; every other model uses
# Chat Completions. Force either with OPENAI_API_STYLE=responses|chat.
# OPENAI_API_STYLE=auto
#
# ── Retrieval tuning ─────────────────────────────────────────────────
# IVFFlat probes = how many of the ~2115 lists the dense scan touches. Lower
# is faster, higher is more recall. ~7ms per probe on the current index.
# IVFFLAT_PROBES=16
# Preload retriever models (query encoder + cross-encoder) at server start so
# the first request does not pay the torch/transformers load. 0 disables.
# RETRIEVER_PRELOAD=1
#
# ── AG-UI stream gating (UI-lag debugging) ───────────────────────────
# The answer (text + answer_replace) and the run lifecycle are ALWAYS sent --
# they are the product output, not debug detail. Everything else is opt-in so
# events can be re-enabled one at a time. Set AGUI_EVENTS to a comma-separated
# list of the optional events, or "all"; restart the backend after changing it.
# Default (unset) = none of the optional events.
#   thinking tool step plan status task run_stats
#   error_detail tool_progress sources verdict_table pipeline question
# AGUI_EVENTS=plan,task,step,thinking,tool_progress,sources,verdict_table,question
#
# ── Shared LLM call pool (agent + small lanes) ───────────────────────
# One process-wide queue per endpoint: parallel deep tasks wait their turn
# instead of tripping rate limits. 429/5xx/timeouts retry with backoff
# (Retry-After honored).
# LLM_RPM=150
# LLM_TPM=500000
# LLM_MAX_INFLIGHT=8
# Per-call LLM deadlines (seconds); the planner fails open to [] and the
# verifier to empty verdicts instead of hanging the run.
# EVIDENCE_PLANNER_TIMEOUT_S=120
# Per-call deadline (seconds) for one System One verification call. The
# verifier degrades to empty verdicts instead of hanging the run.
# VERIFIER_TIMEOUT_S=180
# ── TypeSafe System One verifier (Jev) ─────────────────────────────
# The evidence verifier is a TypeSafe System One client: one Noul (yes/no
# probability) per requirement plus one intent Noul per passage, with the
# verbatim span selected by a Choice. Coverage is a code-side threshold on
# the returned probability. Get a key at https://console.typesafe.ai/.
TYPESAFE_API_KEY=
# Model id; pin a version for reproducible tuning.
# TYPESAFE_MODEL=jev-latest
# Noul probability at/above which a requirement counts as covered. 0.5 is the
# calibrated boundary; raise it to be more conservative, lower it to recall
# more. Tune on your own data.
# TYPESAFE_COVERAGE_THRESHOLD=0.5
# Concurrent System One calls across all passages in a verification pass.
# TYPESAFE_MAX_INFLIGHT=16
# Passage text handed to Jev. A positive value caps each passage; -1 (or 0)
# sends the WHOLE passage untruncated.
# VERIFIER_MAX_CHARS=2000
# Verbatim span options per passage: sentences when they fit, otherwise that
# many contiguous sentence groups so the whole passage is represented.
# VERIFIER_VERBATIM_CANDIDATES=12
# Reuse verdicts within (and across) runs: a passage judged against the same
# question + requirement set + threshold + model is never re-scored. 0 disables.
# VERIFIER_VERDICT_CACHE=1
# Reasoning effort for the NON-judge lanes (orchestrator, planner, research
# legs, shallow agent, synthesizer). Same lever as the judge's: left unset
# the endpoint picks its own (slow) default. Set to default/provider/auto to
# opt out and send no reasoning field.
# AGENT_REASONING_EFFORT=low
# Synthesizer prompt bound: per-passage and total characters of proof text
# inlined into the single final-answer message (0 = no cap). Refs, titles
# and sections always survive, so the citation pool is never lost.
# SYNTH_MAX_PASSAGE_CHARS=3000
# SYNTH_MAX_TOTAL_CHARS=80000
# Human-in-the-loop: how long an ask_user clarification waits for the user
# before the agent proceeds with its best interpretation (seconds).
# HITL_TIMEOUT_S=600
# SEQUENTIAL=1  # debug: deep tasks one at a time + serialized judge output (default: parallel)
# Cross-encoder rerank batch (lower if CUDA OOMs; it halves itself on OOM).
# The fused candidate set reranked is fixed at 60 and is deliberately not
# tunable: the full set is worth the CPU cost.
# CROSS_ENCODER_BATCH_SIZE=16
# Exact-repeat retrieval cache (normalized query + leg/top-k), bounded LRU.
# A leg that retries a query verbatim skips the encoder, both DB legs and the
# CPU cross-encoder entirely. 0 disables.
# RETRIEVAL_CACHE_SIZE=32

# ── Local UMLS / MeSH terminology service ────────────────────────────
# Get a free UTS account + API key at https://uts.nlm.nih.gov/uts/
UMLS_API_KEY=
UMLS_SABS=MSH
UMLS_BASE_URL=https://uts-ws.nlm.nih.gov/rest
UMLS_MAX_SYNONYMS=5

# ── Firecrawl web search (agents flow) ─────────────────────────────────
# Cloud-hosted Firecrawl API. The agents use it for WEB evidence: /v1/search
# for listings, /v1/scrape + /v1/batch/scrape for page text. Social media /
# forums are never trusted; only medical journals + official medical sites
# pass the site-legitimacy gate. Get a key at https://firecrawl.dev.
FIRECRAWL_URL=https://api.firecrawl.dev
FIRECRAWL_API_KEY=fc-your-key-here

# ── Local retrieval / vector store ───────────────────────────────────
INDEX_DIR=index
CHUNKS_DIR=chunks
EMBEDDINGS_DIR=embeddings
# Leave empty to use the FAISS dense index; set to a pgvector DSN to use
# PostgreSQL pgvector instead (see scripts/init_pgvector.py):
VECTOR_DB_URL=
EMBEDDING_MODEL=ncbi/MedCPT-Query-Encoder
# OpenAI-compatible embedding server for make medpat-embed (the ingest step
# that fills medpat.chunk_embeddings). The model must return 768-dim vectors
# to match vector(768); the client L2-normalizes before storing.
EMBEDDING_BASE_URL=https://your-embedding-server/v1
MEDPAT_EMBED_MODEL=ncbi/MedCPT-Article-Encoder
ENABLE_DENSE=false              # dense retrieval needs encoders + index
BM25_DEPTH=100
DENSE_DEPTH=100
RRF_K=60

# ── Research budgets ─────────────────────────────────────────────────
# Evidence targets per requirement + retrieval fan-out (read by the agents
# flow). Stage timeouts and worker fan-out are XDEEP_TIMEOUT_* /
# XDEEP_MAX_WORKERS (see src/agents/timeouts.py).
MAX_DOCUMENTS=8                 # max evidence documents per subquery
# AGENTIC_V3_EVIDENCE_TARGET=3  # verified papers required per requirement
# AGENTIC_V3_MAX_SEARCHES=5     # search budget per worker
# AGENTIC_V3_MAX_RETRIEVAL_ROUNDS=5
# AGENTIC_V3_PAPERS_PER_SEARCH=5
# XDEEP_MAX_WORKERS=4           # parallel research workers
# XDEEP_TIMEOUT_WORKER=360      # seconds per worker; also DECOMPOSE/CONFLICT/
                                # RESOLUTION/GAP/SYNTHESIS/LLM_CALL variants

# ── Langfuse tracing (autonomous deepagents runs) ──────────────────
# One trace per research run (planner → workers → verdicts → synthesis) with
# the conversation_id as session_id. Get keys at Settings → API Keys in your
# Langfuse project (https://langfuse.com/cloud) or self-host. Unset = tracing
# silently off; the pipeline runs exactly the same.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=CHANGEME
# LANGFUSE_BASE_URL=https://cloud.langfuse.com  # US: https://us.cloud.langfuse.com

# ── Logfire observability (Pydantic AI → Logfire) ────────────────────
# Every PydanticAI agent call (prompt, response, tokens, cost, latency) plus
# the application trace events (stages, retrievals, verdicts, deep
# inspections) stream to Logfire. Configure once with `logfire auth` (or run
# `logfire project create`), which writes .logfire/logfire_credentials.json.
#
# LOGFIRE_ENABLED=auto          # auto | 1/on | 0/off
#                               # auto = enabled iff credentials/token exist
# LOGFIRE_SERVICE_NAME=medrag
# LOGFIRE_ENVIRONMENT=development
# LOGFIRE_CONSOLE=false         # true to print spans to the terminal too
#
# Alternative to the credentials file: paste a project write token here.
# LOGFIRE_TOKEN=pylf_v1_...

# ── medpat ParadeDB (corpus storage + pgAdmin frontend) ────────────
# docker/medpat containers: the corpora live in medpat Postgres (ParadeDB).
# `make medpat-up` starts postgres + the pgAdmin UI at http://localhost:5050.
#
# Postgres superuser password for the Postgres container (docker/medpat).
# If you change it, keep docker/medpat/pgadmin/.pgpass in sync.
# MEDPAT_PG_PASSWORD=CHANGEME
# # pgAdmin web login (docker/medpat compose `pgadmin` service).
# PGADMIN_EMAIL=admin@medpat.io
# PGADMIN_PASSWORD=CHANGEME
# Retrieval corpus the dense + BM25 legs read.
#   medpat (default): medpat.chunks + medpat.chunk_embeddings (ParadeDB, HNSW)
#   medrag          : legacy pgvector database, selected via PGHOST/PGPORT/PG*
MEDPAT_PG_SCHEMA=medpat
# libpq DSN of the medpat container (used when the schema is medpat).
MEDPAT_DSN=postgresql://medpat:CHANGEME@localhost:5433/medpat
